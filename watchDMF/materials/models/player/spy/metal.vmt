"VertexLitGeneric"
{
	"$baseTexture" "models\player\spy\metal"
	"$bumpmap" "models\player\spy\metal_normal"
	$halflambert 1

	"$envmap" "env_cubemap"
	"$envmaptint" "[1.1 0.9 0.3]"
	
	"$detail" "models\player\spy\overlay"
	"$detailblendfactor" "0.33"
	"$detailblendmode" "0"
	"$detailscale" "1"

	"$phong" "1"
	"$phongexponent" "2"
	"$phongboost" "15"	
	"$lightwarptexture" "models/weapons/c_models/c_ambassador/c_ambassador_lightwarp"
	"$phongfresnelranges"	"[5 .1 .1]"
	"$phongwarptexture"  "models/weapons/c_models/c_ambassador/c_ambassador_phongwarp"

	"$tempvar" "0"

	"$rimlight" "1"
	"$rimlightexponent" "6"	
	"$rimlightboost" "5"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}